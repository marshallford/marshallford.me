min-release-age=7
# hugo-extended publishes within a day of each Hugo release; without this, bumping it fails ETARGET for a week
min-release-age-exclude=hugo-extended
strict-allow-scripts=true
allow-git=none
allow-remote=none
strict-ssl=true
audit=true
save-exact=true
engine-strict=true
prefer-offline=true
fund=false
